---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import PageTracker from '../components/PageTracker.astro';
---

<Layout title="Seite nicht gefunden | SozialCM">
    <PageTracker pageName="404" pageCategory="error" />
    <Navigation />

    <main class="not-found">
        <div class="container">
            <h1>Seite nicht gefunden</h1>
            <p>Die angeforderte Seite existiert nicht (mehr). Vielleicht finden Sie auf der Startseite, was Sie suchen.</p>
            <p class="not-found__hint">
                <a href="/" class="button button--primary">Zur Startseite</a>
            </p>
        </div>
    </main>

    <Footer />
</Layout>

<style>
    .not-found {
        min-height: 60vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 6rem 1.5rem;
    }

    .container {
        max-width: 800px;
        margin: 0 auto;
    }

    .not-found h1 {
        font-size: clamp(2rem, 4vw, 2.75rem);
        color: var(--color-primary);
        margin-bottom: 1rem;
    }

    .not-found p {
        color: var(--color-text-secondary);
        margin-bottom: 1rem;
    }

    .not-found__hint {
        margin-top: 2rem;
    }
</style>
